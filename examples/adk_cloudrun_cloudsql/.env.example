# ==============================================================================
# Google ADK + Cloud Run + Cloud SQL Environment Configuration
# ==============================================================================
# Copy this file to .env and replace placeholder values with your GCP configurations.

# --- 1. Google Gemini / GenAI Credentials ---
# Required for agent inference with Gemini 2.5 Flash / Gemini 3.7 Flash.
# Get your API key from Google AI Studio: https://aistudio.google.com/app/api-keys
# Or leave blank if running in GCP Cloud Run with Vertex AI ADC (Application Default Credentials).
GEMINI_API_KEY="your-gemini-api-key-here"
GOOGLE_GENAI_API_KEY="your-gemini-api-key-here"

# --- 2. Google Cloud Platform Project Details ---
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="us-central1"
SERVICE_NAME="adk-agent-service"

# --- 3. Google Cloud SQL (PostgreSQL) Configuration ---
# Cloud SQL Instance Connection Name format: <PROJECT-ID>:<REGION>:<INSTANCE-NAME>
# Example: my-project:us-central1:adk-postgres-instance
CLOUD_SQL_CONNECTION_NAME="your-gcp-project-id:us-central1:adk-postgres"

# Database connection credentials
DB_USER="adk_agent_user"
DB_PASSWORD="your-secure-database-password"
DB_NAME="adk_agent_db"
DB_PORT="5432"
DB_HOST="127.0.0.1"

# Database Connection URI
# Local development with Cloud SQL Auth Proxy: postgresql+asyncpg://adk_agent_user:password@127.0.0.1:5432/adk_agent_db
# Cloud Run Unix Socket: postgresql+asyncpg://adk_agent_user:password@/adk_agent_db?host=/cloudsql/your-gcp-project-id:us-central1:adk-postgres
# Standalone local fallback: sqlite+aiosqlite:///./local_adk_sessions.db
DATABASE_URL="sqlite+aiosqlite:///./local_adk_sessions.db"

# --- 4. Server & UI Settings ---
PORT=8080
HOST="0.0.0.0"
ENVIRONMENT="development"
ENABLE_WEB_UI="true"
