{
  "name": "cosm-vscode",
  "displayName": "Cosm AST SCM & Polyglot Architecture",
  "description": "AI-Native Polyglot AST Source Control, Micro-Universes, and 3-Tier Topology for VS Code & Antigravity IDE",
  "version": "0.1.0",
  "publisher": "cosmscm",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Source Control",
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "ast",
    "scm",
    "polyglot",
    "merkle",
    "micro-universe",
    "lineage",
    "topocosm"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.cosm"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cosm-explorer",
          "title": "Cosm AST",
          "icon": "$(globe)"
        }
      ]
    },
    "views": {
      "cosm-explorer": [
        {
          "id": "cosm.astTreeView",
          "name": "AST Merkle Tree Explorer",
          "type": "tree"
        },
        {
          "id": "cosm.topologyTreeView",
          "name": "Architecture Topology (Frontend → Backend → Infra)",
          "type": "tree"
        }
      ],
      "scm": [
        {
          "id": "cosm.scmView",
          "name": "Cosm Stacks (Jujutsu-style)",
          "type": "list"
        }
      ]
    },
    "commands": [
      {
        "command": "cosm.switchUniverse",
        "title": "Cosm: Switch Micro-Universe",
        "category": "Cosm",
        "icon": "$(git-branch)"
      },
      {
        "command": "cosm.createUniverse",
        "title": "Cosm: Create Micro-Universe (Zero-Copy Branch)",
        "category": "Cosm",
        "icon": "$(add)"
      },
      {
        "command": "cosm.openTopology",
        "title": "Cosm: Open Cross-Domain Topology Canvas",
        "category": "Cosm",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "cosm.commit",
        "title": "Cosm: Commit AST Changes",
        "category": "Cosm",
        "icon": "$(check)"
      },
      {
        "command": "cosm.commitWithPrompt",
        "title": "Cosm: Commit AST Symbols (Intent & Prompt)",
        "category": "Cosm",
        "icon": "$(check)"
      },
      {
        "command": "cosm.shipPreview",
        "title": "Cosm: Ship Target & Ephemeral Preview",
        "category": "Cosm",
        "icon": "$(rocket)"
      },
      {
        "command": "cosm.blastRadius",
        "title": "Cosm: Audit Blast Radius & Downstream Contracts",
        "category": "Cosm",
        "icon": "$(pulse)"
      },
      {
        "command": "cosm.refreshSCM",
        "title": "Cosm: Refresh Workspace & Micro-Universe State",
        "category": "Cosm",
        "icon": "$(refresh)"
      },
      {
        "command": "cosm.stageFile",
        "title": "Cosm: Stage AST Component",
        "category": "Cosm",
        "icon": "$(plus)"
      },
      {
        "command": "cosm.unstageFile",
        "title": "Cosm: Unstage AST Component",
        "category": "Cosm",
        "icon": "$(remove)"
      },
      {
        "command": "cosm.stageAll",
        "title": "Cosm: Stage All AST Components",
        "category": "Cosm",
        "icon": "$(plus)"
      },
      {
        "command": "cosm.unstageAll",
        "title": "Cosm: Unstage All AST Components",
        "category": "Cosm",
        "icon": "$(remove)"
      },
      {
        "command": "cosm.diffSymbol",
        "title": "Cosm: Compare Symbol AST with Head",
        "category": "Cosm"
      },
      {
        "command": "cosm.resolveSymbol",
        "title": "Cosm: Resolve Symbol AST Details",
        "category": "Cosm"
      },
      {
        "command": "cosm.refreshASTTree",
        "title": "Cosm: Refresh AST Merkle Tree",
        "category": "Cosm",
        "icon": "$(refresh)"
      },
      {
        "command": "cosm.navigateToSymbol",
        "title": "Cosm: Navigate to AST Symbol",
        "category": "Cosm",
        "icon": "$(go-to-file)"
      },
      {
        "command": "cosm.viewASTPayload",
        "title": "Cosm: View AST Payload & IR",
        "category": "Cosm",
        "icon": "$(file-code)"
      },
      {
        "command": "cosm.copyNodeId",
        "title": "Cosm: Copy AST Node ID",
        "category": "Cosm",
        "icon": "$(clippy)"
      },
      {
        "command": "cosm.explainMerkleNodes",
        "title": "Cosm: What is an AST Merkle Node?",
        "category": "Cosm",
        "icon": "$(shield)"
      },
      {
        "command": "cosm.refreshTopologyTree",
        "title": "Cosm: Refresh Architecture Topology",
        "category": "Cosm",
        "icon": "$(refresh)"
      },
      {
        "command": "cosm.createStack",
        "title": "Cosm: Create Stacked Change (Jujutsu-style)",
        "category": "Cosm",
        "icon": "$(layers)"
      },
      {
        "command": "cosm.evolveStack",
        "title": "Cosm: Evolve Stack (Auto-Rebase Descendants)",
        "category": "Cosm",
        "icon": "$(zap)"
      },
      {
        "command": "cosm.refreshStack",
        "title": "Cosm: Refresh Stacked Proposals",
        "category": "Cosm",
        "icon": "$(refresh)"
      },
      {
        "command": "cosm.mergeUniverse",
        "title": "Cosm: Merge Micro-Universe (AST Union / Fast-Forward)",
        "category": "Cosm",
        "icon": "$(git-merge)"
      },
      {
        "command": "cosm.showLog",
        "title": "Cosm: View Micro-Universe Commit History & Log",
        "category": "Cosm",
        "icon": "$(history)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cosm.explainMerkleNodes",
          "group": "navigation@1",
          "when": "view == cosm.astTreeView"
        },
        {
          "command": "cosm.refreshASTTree",
          "group": "navigation@2",
          "when": "view == cosm.astTreeView"
        },
        {
          "command": "cosm.openTopology",
          "group": "navigation@1",
          "when": "view == cosm.topologyTreeView"
        },
        {
          "command": "cosm.refreshTopologyTree",
          "group": "navigation@2",
          "when": "view == cosm.topologyTreeView"
        },
        {
          "command": "cosm.mergeUniverse",
          "group": "navigation@1",
          "when": "view == cosm.scmView"
        },
        {
          "command": "cosm.createStack",
          "group": "navigation@2",
          "when": "view == cosm.scmView"
        },
        {
          "command": "cosm.evolveStack",
          "group": "navigation@3",
          "when": "view == cosm.scmView"
        },
        {
          "command": "cosm.refreshStack",
          "group": "navigation@4",
          "when": "view == cosm.scmView"
        }
      ],
      "view/item/context": [
        {
          "command": "cosm.viewASTPayload",
          "when": "viewItem == cosm.symbol",
          "group": "inline@1"
        },
        {
          "command": "cosm.copyNodeId",
          "when": "viewItem == cosm.symbol || viewItem == cosm.detailNodeId",
          "group": "inline@2"
        },
        {
          "command": "cosm.diffSymbol",
          "when": "viewItem == cosm.symbol",
          "group": "cosm@1"
        },
        {
          "command": "cosm.blastRadius",
          "when": "viewItem == cosm.symbol || viewItem == cosm.topologyNode",
          "group": "cosm@2"
        },
        {
          "command": "cosm.switchUniverse",
          "group": "inline@1",
          "when": "view == cosm.scmView && viewItem == stackedChange"
        },
        {
          "command": "cosm.evolveStack",
          "group": "inline@2",
          "when": "view == cosm.scmView && viewItem == stackedChange"
        },
        {
          "command": "cosm.mergeUniverse",
          "group": "inline@3",
          "when": "view == cosm.scmView && viewItem == stackedChange"
        }
      ],
      "scm/title": [
        {
          "command": "cosm.commit",
          "group": "navigation@1",
          "when": "scmProvider == cosm"
        },
        {
          "command": "cosm.mergeUniverse",
          "group": "navigation@2",
          "when": "scmProvider == cosm"
        },
        {
          "command": "cosm.showLog",
          "group": "navigation@3",
          "when": "scmProvider == cosm"
        },
        {
          "command": "cosm.createStack",
          "group": "navigation@4",
          "when": "scmProvider == cosm"
        },
        {
          "command": "cosm.refreshSCM",
          "group": "navigation@5",
          "when": "scmProvider == cosm"
        },
        {
          "command": "cosm.commitWithPrompt",
          "group": "1_modification",
          "when": "scmProvider == cosm"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "cosm.stageAll",
          "group": "inline@1",
          "when": "scmResourceGroup == modified"
        },
        {
          "command": "cosm.unstageAll",
          "group": "inline@1",
          "when": "scmResourceGroup == staged"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "cosm.stageFile",
          "group": "inline@1",
          "when": "scmResourceGroup == modified"
        },
        {
          "command": "cosm.unstageFile",
          "group": "inline@1",
          "when": "scmResourceGroup == staged"
        },
        {
          "command": "cosm.diffSymbol",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "command": "cosm.openTopology",
          "group": "cosm@1"
        },
        {
          "command": "cosm.blastRadius",
          "group": "cosm@2"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Cosm AST SCM & Polyglot Architecture",
      "properties": {
        "cosm.binaryPath": {
          "type": "string",
          "default": "cosm",
          "description": "Path to the cosm CLI binary (or 'cosm' if in PATH, or relative path to repo bin)."
        },
        "cosm.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Automatically synchronize workspace source files to disk on AST mutations."
        },
        "cosm.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show causal lineage and agent pedigree CodeLens above AST symbols."
        },
        "cosm.topocosmUrl": {
          "type": "string",
          "default": "https://topocosm.dev",
          "description": "Topocosm cloud distribution hub URL."
        },
        "cosm.previewTarget": {
          "type": "string",
          "default": "local-preview",
          "description": "Target profile to use for 'cosm ship' ephemeral builds."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npx tsc -p ./",
    "watch": "npx tsc -watch -p ./",
    "package": "python3 package_vsix.py",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
